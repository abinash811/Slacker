# --- Database ---
# Standard Postgres URL. Works unchanged against local Docker Postgres,
# Supabase Postgres, or AWS RDS Postgres.
DATABASE_URL=postgresql+psycopg://slacker:slacker@localhost:5432/slacker

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Dev auth (replace with company SSO integration later; see AuthProvider) ---
DEV_DEFAULT_USER_EMAIL=admin@example.com

# --- Slack app credentials (create your own app; see docs/SLACK_SETUP.md) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Only needed if you build out multi-workspace OAuth install later — leave
# these two commented out (not just blank) for V1's manual single-workspace
# install. Slack Bolt checks `os.environ.get("SLACK_CLIENT_ID") is not None`,
# so even an empty value still counts as "set" and silently switches Bolt
# into OAuth mode, ignoring SLACK_BOT_TOKEN above.
# SLACK_CLIENT_ID=your-client-id
# SLACK_CLIENT_SECRET=your-client-secret

# Use Socket Mode locally if you cannot expose a public HTTP URL (dev only).
# Production should always use HTTP Events API (SLACK_USE_SOCKET_MODE=false).
SLACK_USE_SOCKET_MODE=false

# Fallback channel used when a team has no dedicated channel mapping.
SLACK_DEFAULT_CHANNEL_ID=C0000000000

# Optional: your Slack workspace subdomain (the "acme" in acme.slack.com),
# used only to build "Open in Slack" links in the dashboard.
SLACK_WORKSPACE_DOMAIN=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
